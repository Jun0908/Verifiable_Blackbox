# Browser-safe Privy and chain configuration
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=
# Server-only RPC override, e.g. an Alchemy Sepolia HTTPS endpoint.
SEPOLIA_RPC_URL=

# Server-only demo keys. Use disposable Testnet keys; never use production keys.
DEPLOYER_PRIVATE_KEY=
DEMO_CLIENT_PRIVATE_KEY=
DEMO_PROVIDER_PRIVATE_KEY=
DEMO_RELAYER_PRIVATE_KEY=
DEMO_TEE_PRIVATE_KEY=

# Defaults to demo.web.json. Set demo.testnet.json for the Sepolia demo.
DEMO_DEPLOYMENT_FILE=demo.web.json
ALLOW_PUBLIC_DEMO_AUTOMATION=false

# Server-only verifier adapter. PHALA_VERIFIER_URL is never sent to the browser.
DEMO_VERIFIER_MODE=MOCK_TEE
PHALA_VERIFIER_URL=https://replace-with-phala-endpoint.example
PHALA_VERIFIER_TIMEOUT_MS=10000
# Optional gateway authentication. Do not prefix with NEXT_PUBLIC_.
PHALA_VERIFIER_BEARER_TOKEN=
