# Browser-safe Privy and chain configuration
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=
# Server-only RPC override, e.g. an Alchemy Sepolia HTTPS endpoint.
SEPOLIA_RPC_URL=
DEMO_RPC_URL=http://127.0.0.1:8545
# Set only for the public Anvil test wallet. Never enable it on external chains.
NEXT_PUBLIC_LOCAL_DEMO=false

# Server-only demo keys. Use disposable Testnet keys; never use production keys.
DEPLOYER_PRIVATE_KEY=
# Optional previous Sepolia deployer address for an additional equality check.
PREVIOUS_DEPLOYER_ADDRESS=
DEMO_CLIENT_PRIVATE_KEY=
DEMO_PROVIDER_PRIVATE_KEY=
DEMO_RELAYER_PRIVATE_KEY=
DEMO_TEE_PRIVATE_KEY=
# Dedicated Sepolia demo gas pool; created by scripts/setup-demo-gas.mjs --create-wallet.
DEMO_GAS_FAUCET_ENABLED=false
DEMO_GAS_FAUCET_PRIVATE_KEY=
# Optional persistent ledger directory. Default: apps/web/.demo-gas (ignored).
# DEMO_GAS_DIR=

# Required to deploy on Sepolia. Provider/relayer addresses must match their keys.
# The TEE signer must match the Phala service; its private key stays with that service.
DEMO_PROVIDER_ADDRESS=
DEMO_RELAYER_ADDRESS=
DEMO_TEE_SIGNER_ADDRESS=

# Defaults to demo.web.json. Set demo.testnet.json for the Sepolia demo.
DEMO_DEPLOYMENT_FILE=demo.web.json
ALLOW_PUBLIC_DEMO_AUTOMATION=false

# Server-only verifier adapter. PHALA_VERIFIER_URL is never sent to the browser.
DEMO_VERIFIER_MODE=MOCK_TEE
PHALA_VERIFIER_URL=https://replace-with-phala-endpoint.example
PHALA_VERIFIER_TIMEOUT_MS=10000
# Optional gateway authentication. Do not prefix with NEXT_PUBLIC_.
PHALA_VERIFIER_BEARER_TOKEN=

# Real Rover bridge, started by npm run demo:sepolia. Uses the sibling project's private settings.
# ROVER_PYTHON_ROOT=D:/Codex/ETH Hackathon Idea/M5stack_RoverC/rover-python
# ROVER_PYTHON=D:/Codex/ETH Hackathon Idea/M5stack_RoverC/rover-python/.venv/Scripts/python.exe
# VBB_BRIDGE_PORT=8765
# Optional overrides for an already configured network; no Wi-Fi switching is performed.
# ROVER_BASE_URL=http://robot-address
# ROVER_SETTINGS_FILE=D:/path/to/rover-python/config/rover.hotspot.json
