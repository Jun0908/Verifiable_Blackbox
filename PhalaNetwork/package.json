{
  "name": "@vbb/phala-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10.9.4 <11"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e:local": "npm run build && node scripts/e2e-local.mjs",
    "e2e:approval": "npm run build && node scripts/e2e-approval.mjs",
    "test:evidence-compat": "npm run build && node --experimental-transform-types scripts/check-evidence-compat.mjs",
    "e2e:docker": "npm run build && docker build -t vbb-phala-verifier:local . && node scripts/e2e-local.mjs --docker"
  },
  "dependencies": {
    "viem": "2.56.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
