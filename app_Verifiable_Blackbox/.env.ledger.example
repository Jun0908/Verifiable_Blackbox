# Copy these server settings into the root .env.
MULTIBAAS_URL=https://YOUR_DEPLOYMENT.multibaas.com/api/v0
MULTIBAAS_API_KEY=YOUR_SERVER_API_KEY
LEDGER_CONFIRMATIONS=12
# First block of the configured ledger contracts; refresh discovers completed Jobs from here.
LEDGER_FROM_BLOCK=11782739
# Optional absolute snapshot directory. Default: apps/web/.ledger with the Web launcher.
# LEDGER_DIR=
