{
  "name": "verifiable-blackbox-demo",
  "private": true,
  "workspaces": [
    "apps/*",
    "parts/device-signature"
  ],
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10.9.4 <11"
  },
  "scripts": {
    "contracts:build": "node scripts/foundry.mjs forge build",
    "contracts:test": "node scripts/foundry.mjs forge test",
    "test:evidence": "node --experimental-transform-types scripts/test-evidence.mjs",
    "demo:local": "node scripts/local-stack.mjs",
    "test:web-api": "node scripts/local-stack.mjs --test",
    "test:demo-review": "node --experimental-transform-types scripts/test-demo-review.mjs",
    "test:payment-block": "node --experimental-transform-types scripts/test-rover-payment-block.mjs",
    "test:job-flow": "node --import ./scripts/register-ts.mjs --experimental-transform-types scripts/test-job-flow.mjs",
    "test:job-history": "node --import ./scripts/register-ts.mjs --experimental-transform-types scripts/test-job-history.mjs",
    "demo:phala-local": "node scripts/local-stack.mjs --phala",
    "test:phala-local": "node scripts/local-stack.mjs --test --phala",
    "dev:web": "npm --workspace @vbb/web run dev -- --hostname 127.0.0.1",
    "typecheck:web": "npm --workspace @vbb/web run typecheck",
    "build:web": "npm --workspace @vbb/web run build",
    "test:rover": "node --import ./scripts/register-ts.mjs --experimental-transform-types --test scripts/test-rover-gripper.mjs scripts/test-rover-camera.mjs",
    "demo:rover": "node scripts/local-stack.mjs --rover-mock",
    "demo:rover-hardware": "node scripts/local-stack.mjs --phala --rover",
    "test:device": "node --test parts/device-signature/test/*.test.mjs",
    "test:device-contracts": "node scripts/foundry.mjs forge test --root parts/device-signature",
    "test:device-local": "node parts/device-signature/test-local.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:phala": "node scripts/validate.mjs --phala",
    "demo:rover-phala": "node scripts/local-stack.mjs --phala --rover-mock",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.61.1"
  }
}
